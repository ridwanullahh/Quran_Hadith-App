<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Android 12+ backup rules. We disable backup entirely because:
        * The app stores user reading history, bookmarks, notes, hifdh
          progress — personal religious data that should not leave the
          device via backup.
        * Backup could leak this data to Google cloud or to a new owner
          after a device transfer.

      If cloud backup is later desired, scope it to specific Hive boxes
      via <include> rules instead of enabling full backup.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
